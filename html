<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vanguard Steelworks</title>
  <meta name="description" content="Precision steel fabrication and structural engineering services.">

  <style>
    :root {
      --navy: #111827;
      --navy-2: #1f2937;
      --steel: #e5e7eb;
      --orange: #f97316;
      --orange-dark: #ea580c;
      --white: #ffffff;
      --muted: #6b7280;
      --light: #f3f4f6;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--navy);
      line-height: 1.6;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1120px, calc(100% - 40px));
      margin-inline: auto;
    }

    .topbar {
      background: var(--navy);
      color: var(--white);
      font-size: 13px;
    }

    .topbar-inner {
      min-height: 38px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .topbar a {
      color: var(--white);
    }

    header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(255,255,255,.97);
      border-bottom: 1px solid #e5e7eb;
    }

    .nav {
      height: 78px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      font-size: 21px;
      letter-spacing: -.5px;
      text-transform: uppercase;
    }

    .brand-mark {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      background: var(--orange);
      color: white;
      clip-path: polygon(25% 0, 100% 0, 75% 100%, 0 100%);
      font-size: 20px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 14px;
      font-weight: 700;
    }

    .nav-links a:hover {
      color: var(--orange);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 24px;
      border: 0;
      border-radius: 2px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .5px;
      cursor: pointer;
      transition: .2s ease;
    }

    .btn-primary {
      background: var(--orange);
      color: white;
    }

    .btn-primary:hover {
      background: var(--orange-dark);
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 2px solid white;
      color: white;
      background: transparent;
    }

    .btn-outline:hover {
      background: white;
      color: var(--navy);
    }

    .hero {
      min-height: 660px;
      display: flex;
      align-items: center;
      position: relative;
      color: white;
      background:
        linear-gradient(90deg, rgba(17,24,39,.96) 0%, rgba(17,24,39,.78) 52%, rgba(17,24,39,.25) 100%),
        url("https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1800&q=85") center/cover;
    }

    .hero-content {
      max-width: 660px;
      padding: 80px 0;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 18px;
      color: var(--orange);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 630px;
      font-size: clamp(48px, 7vw, 78px);
      line-height: .98;
      letter-spacing: -3px;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .hero p {
      max-width: 560px;
      margin-bottom: 34px;
      color: #d1d5db;
      font-size: 18px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .stats {
      background: var(--navy);
      color: white;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .stat {
      min-height: 150px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border-right: 1px solid rgba(255,255,255,.12);
      text-align: center;
    }

    .stat:last-child {
      border-right: 0;
    }

    .stat strong {
      color: var(--orange);
      font-size: 42px;
      line-height: 1;
    }

    .stat span {
      margin-top: 10px;
      color: #d1d5db;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
    }

    section {
      padding: 100px 0;
    }

    .section-heading {
      max-width: 670px;
      margin-bottom: 48px;
    }

    .section-heading.center {
      margin-inline: auto;
      text-align: center;
    }

    .section-heading h2 {
      font-size: clamp(36px, 5vw, 52px);
      line-height: 1.05;
      letter-spacing: -2px;
      text-transform: uppercase;
    }

    .section-heading p {
      margin-top: 16px;
      color: var(--muted);
      font-size: 17px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .service-card {
      border: 1px solid #e5e7eb;
      background: white;
      transition: .25s ease;
    }

    .service-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(17,24,39,.12);
      border-color: transparent;
    }

    .service-card img {
      width: 100%;
      height: 240px;
      object-fit: cover;
    }

    .service-card-content {
      padding: 28px;
    }

    .service-number {
      color: var(--orange);
      font-size: 12px;
      font-weight: 800;
    }

    .service-card h3 {
      margin: 8px 0 10px;
      font-size: 23px;
      text-transform: uppercase;
    }

    .service-card p {
      color: var(--muted);
    }

    .about {
      background: var(--light);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-image {
      position: relative;
    }

    .about-image img {
      width: 100%;
      height: 520px;
      object-fit: cover;
    }

    .experience {
      position: absolute;
      right: -20px;
      bottom: -20px;
      width: 180px;
      height: 180px;
      display: grid;
      place-content: center;
      background: var(--orange);
      color: white;
      text-align: center;
      text-transform: uppercase;
    }

    .experience strong {
      font-size: 44px;
      line-height: 1;
    }

    .feature-list {
      margin-top: 28px;
      display: grid;
      gap: 16px;
    }

    .feature {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    .feature-icon {
      flex: 0 0 34px;
      height: 34px;
      display: grid;
      place-items: center;
      background: var(--navy);
      color: white;
      font-weight: 800;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr 1fr;
      grid-template-rows: 240px 240px;
      gap: 16px;
    }

    .project {
      position: relative;
      overflow: hidden;
      color: white;
    }

    .project:first-child {
      grid-row: span 2;
    }

    .project img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .4s ease;
    }

    .project:hover img {
      transform: scale(1.06);
    }

    .project-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: end;
      padding: 24px;
      background: linear-gradient(transparent 30%, rgba(17,24,39,.9));
    }

    .project-overlay span {
      color: var(--orange);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .project-overlay h3 {
      margin-top: 4px;
      text-transform: uppercase;
    }

    .process {
      background: var(--navy);
      color: white;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }

    .process-step {
      position: relative;
      border-top: 3px solid #374151;
      padding-top: 26px;
    }

    .process-step::before {
      content: "";
      position: absolute;
      top: -7px;
      left: 0;
      width: 12px;
      height: 12px;
      background: var(--orange);
    }

    .process-step span {
      color: var(--orange);
      font-size: 13px;
      font-weight: 800;
    }

    .process-step h3 {
      margin: 10px 0;
      text-transform: uppercase;
    }

    .process-step p {
      color: #9ca3af;
    }

    .cta {
      background:
        linear-gradient(rgba(249,115,22,.92), rgba(234,88,12,.92)),
        url("https://images.unsplash.com/photo-1565008447742-97f6f38c985c?auto=format&fit=crop&w=1600&q=85") center/cover;
      color: white;
      padding: 70px 0;
    }

    .cta-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
    }

    .cta h2 {
      max-width: 700px;
      font-size: clamp(34px, 5vw, 52px);
      line-height: 1.05;
      text-transform: uppercase;
    }

    .cta .btn-primary {
      flex-shrink: 0;
      background: white;
      color: var(--orange-dark);
    }

    footer {
      background: #0c1220;
      color: #d1d5db;
      padding: 70px 0 30px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.3fr;
      gap: 50px;
    }

    footer .brand {
      color: white;
      margin-bottom: 18px;
    }

    footer h4 {
      color: white;
      margin-bottom: 18px;
      text-transform: uppercase;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin: 8px 0;
    }

    footer a:hover {
      color: var(--orange);
    }

    .copyright {
      margin-top: 50px;
      padding-top: 24px;
      border-top: 1px solid #1f2937;
      font-size: 13px;
      color: #9ca3af;
    }

    .menu-btn {
      display: none;
      border: 0;
      background: none;
      font-size: 26px;
      cursor: pointer;
    }

    @media (max-width: 900px) {
      .topbar {
        display: none;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 78px;
        left: 0;
        right: 0;
        padding: 20px;
        background: white;
        border-top: 1px solid #e5e7eb;
        flex-direction: column;
      }

      .nav-links.open {
        display: flex;
      }

      .stats-grid,
      .services-grid,
      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .stat:nth-child(2) {
        border-right: 0;
      }

      .about-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .projects-grid {
        grid-template-columns: 1fr 1fr;
      }

      .project:first-child {
        grid-column: span 2;
        grid-row: auto;
      }
    }

    @media (max-width: 600px) {
      .container {
        width: min(100% - 28px, 1120px);
      }

      section {
        padding: 70px 0;
      }

      .hero {
        min-height: 600px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .stats-grid,
      .services-grid,
      .process-grid,
      .projects-grid {
        grid-template-columns: 1fr;
      }

      .stat {
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,.12);
      }

      .about-grid {
        gap: 45px;
      }

      .about-image img {
        height: 400px;
      }

      .experience {
        right: 10px;
        bottom: -20px;
        width: 140px;
        height: 140px;
      }

      .project:first-child {
        grid-column: auto;
      }

      .project {
        height: 260px;
      }

      .cta-inner {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-grid {
        gap: 35px;
      }
    }
  </style>
</head>

